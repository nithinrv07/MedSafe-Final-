# Copy to .env and fill in. Never commit .env.

PORT=3000

# --- Email OTP (required in production) ---
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL=your-sender@example.com
APP_PASSWORD=

# Local development only: show the OTP in the sign-in screen when email is not
# configured. Ignored when NODE_ENV=production.
OTP_DEV_ECHO=false

# --- AI document reading (optional) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Persistence (optional; in-memory if unset) ---
# Firebase Realtime Database URL. When set, BACKEND_EMAIL/BACKEND_PASSWORD are required:
# the server signs in to Firebase Auth as this account to read/write the database.
FIREBASE_DATABASE_URL=
BACKEND_EMAIL=
BACKEND_PASSWORD=
# Optional overrides for the Firebase web config (public values, not secrets)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=

# --- Demo data ---
# Seed the three demo accounts (passcode "password") when the database is empty.
# Default: true in development, false in production.
SEED_DEMO_DATA=
# Allow POST /api/reset in development (always disabled in production).
ALLOW_DEMO_RESET=true
